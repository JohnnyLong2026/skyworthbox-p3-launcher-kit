<?xml version="1.0" encoding="utf-8"?>
<!-- tvOS pill: flat glass, and on focus the whole control lifts and gains a white edge. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Chosen, and the remote is on it: solid white with a faint inner edge so the lift reads. -->
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
            <stroke android:width="3dp" android:color="#59000000" />
            <corners android:radius="27dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_focus" />
            <stroke android:width="2.5dp" android:color="@color/accent" />
            <corners android:radius="27dp" />
        </shape>
    </item>
    <!-- Chosen but not focused: solid white, dark text (see text_pill). -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
            <corners android:radius="27dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <corners android:radius="27dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass" />
            <stroke android:width="1dp" android:color="@color/hairline" />
            <corners android:radius="27dp" />
        </shape>
    </item>
</selector>
