<?xml version="1.0" encoding="utf-8"?>
<!-- Squarer than a pill: the app picker row and the picker's own list rows. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_focus" />
            <stroke android:width="2.5dp" android:color="@color/accent" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#26FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass" />
            <stroke android:width="1dp" android:color="@color/hairline" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
